# The environment the integration-test harness reads.
#
# `env.run.sh` turns this file into `.env` by expanding each default against whatever the shell
# already has, so a value set in CI wins and a value absent locally falls back to the default on
# the right. Nothing here is a secret: JAHIA_LICENSE arrives from the organisation secret, and is
# empty when nobody supplied one - which is a failure the workflow reports rather than hides.
JAHIA_VERSION=${JAHIA_VERSION:-LATEST}
JAHIA_IMAGE=${JAHIA_IMAGE:-ghcr.io/jahia/jahia-ee-dev:8-SNAPSHOT}
TESTS_IMAGE=${TESTS_IMAGE:-jahia/browse-content-types:latest}
MODULE_ID=${MODULE_ID:-browse-content-types}
MANIFEST=${MANIFEST:-provisioning-manifest-build.yml}
JAHIA_URL=${JAHIA_URL:-http://jahia:8080}
SUPER_USER_PASSWORD=${SUPER_USER_PASSWORD:-root1234}
NEXUS_USERNAME=${NEXUS_USERNAME:-NEXUS_USERNAME}
NEXUS_PASSWORD=${NEXUS_PASSWORD:-NEXUS_PASSWORD}
JAHIA_LICENSE=${JAHIA_LICENSE:-""}
TIMEZONE=${TIMEZONE:-America/Toronto}
SKIP_TESTS=${SKIP_TESTS:-false}
CATALINA_OPTS="-Xmx3G -Xms3G -XshowSettings:vm"
JAHIA_CLUSTER_ENABLED=${JAHIA_CLUSTER_ENABLED:-false}
