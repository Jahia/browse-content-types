<?xml version="1.0" encoding="UTF-8"?>
<!--
    Adds the permission to the existing site-administrator role rather than defining that role:
    a module's roles.xml merges into what is already there.
-->
<roles jcr:primaryType="jnt:roles"
       xmlns:jcr="http://www.jcp.org/jcr/1.0"
       xmlns:j="http://www.jahia.org/jahia/1.0"
       xmlns:jnt="http://www.jahia.org/jahia/nt/1.0">
    <site-administrator jcr:primaryType="jnt:role" j:permissionNames="siteAdminContentTypes"/>
</roles>
