{
  "extends": "@jahia",
  "plugins": [
    "react",
    "import"
  ],
  "parserOptions": {
    "requireConfigFile": false,
    "babelOptions": {
      "presets": [
        "@babel/preset-react"
      ]
    }
  },
  "rules": {
    "import/named": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.spec.js",
        "**/*.spec.jsx"
      ],
      "extends": [
        "plugin:jest/recommended"
      ],
      "env": {
        "jest": true
      }
    }
  ]
}
